{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "LeedAB",
  "colors": {
    "primary": "#3F73A0",
    "light": "#6FA3C9",
    "dark": "#1F4D7A"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FAF9F6",
      "dark": "#0B0A08"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "introduction",
          "quickstart"
        ]
      },
      {
        "group": "Core concepts",
        "pages": [
          "essentials/workspaces",
          "essentials/artificial-beings",
          "essentials/the-coo",
          "essentials/governance"
        ]
      },
      {
        "group": "Using LeedAB",
        "pages": [
          "essentials/the-console",
          "essentials/working-with-abs",
          "essentials/sharing"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "operators"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://leedab.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the console",
      "href": "https://app.leedab.com"
    }
  },
  "search": {
    "prompt": "Search the LeedAB docs..."
  },
  "seo": {
    "metatags": {
      "og:title": "LeedAB Docs - operators that run your back office",
      "og:description": "LeedAB hires a team of operators that run your back office across your portals, inboxes, ERPs and spreadsheets. Every action is governed and audited.",
      "og:image": "/images/og-image.png",
      "twitter:card": "summary_large_image",
      "twitter:title": "LeedAB Docs",
      "twitter:description": "Operators that run your back office. Every action governed and audited."
    },
    "indexing": "navigable"
  }
}
